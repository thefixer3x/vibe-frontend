  "sourceRoot": "apps/vibe-frontend",
  "projectType": "application",
  "tags": [],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd apps/vibe-frontend && bun run dev"
