# MCP Gateway Configuration
# Copy this to your .env.local file

# MCP Gateway (Required)
NEXT_PUBLIC_MCP_GATEWAY_URL=https://link.seyederick.com

# API Key for authenticated access (Required for your setup)
# Use either the master key or vibe key from your MCP gateway config
NEXT_PUBLIC_MCP_API_KEY=vibe_frontend_key_2024

# Alternative: Use master key for full access
# NEXT_PUBLIC_MCP_API_KEY=lano_master_key_2024

# Development settings
NODE_ENV=development

# Optional: Enable debug logging
NEXT_PUBLIC_DEBUG_MCP=true
